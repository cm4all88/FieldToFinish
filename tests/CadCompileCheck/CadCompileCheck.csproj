<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CA1416</NoWarn>
    <RootNamespace>FieldCodes.Cad</RootNamespace>
    <AssemblyName>CadCompileCheck</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- WPF, as the real project references it: the ribbon icons and the ribbon API types. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <ProjectReference Include="..\..\src\FieldCodes\FieldCodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Stubs/*.cs" />
    <!-- The whole plugin, every file: a branch merged into integration must compile as one. -->
    <Compile Include="..\..\src\FieldCodes.Cad\**\*.cs" Exclude="..\..\src\FieldCodes.Cad\obj\**;..\..\src\FieldCodes.Cad\bin\**" LinkBase="FieldCodes.Cad" />
  </ItemGroup>
</Project>
