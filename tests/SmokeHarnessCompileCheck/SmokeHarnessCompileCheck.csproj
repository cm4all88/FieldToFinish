<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the Civil 3D harnesses deploy\smoke-test.ps1 and run-figures.ps1 compile, the way they compile them: C# 5
    (the .NET Framework csc), against accoremgd, acdbmgd, acmgd and AeccDbMgd only: AutoCAD's real
    2024 reference assemblies (AutoCAD.NET 24.3.0) and the Civil 3D stand-ins. A harness that does
    not compile there fails every UPDATEFTF; this catches it on any machine first.

      dotnet build tests/SmokeHarnessCompileCheck

    What it cannot catch: a Civil 3D member the stand-ins get wrong, and anything at run time.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SmokeHarnessCompileCheck</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AutoCAD.NET" Version="24.3.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <ProjectReference Include="CivilStubs\CivilStubs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every harness deploy\smoke-test.ps1 and tests\LiveSmoke\run-figures.ps1 compile
         (DeploymentContractTests keeps this list honest). -->
    <Compile Include="..\LiveSmoke\ContourTestHarness.cs" Link="ContourTestHarness.cs" />
    <Compile Include="..\LiveSmoke\StyleTestHarness.cs" Link="StyleTestHarness.cs" />
    <Compile Include="..\LiveSmoke\IdentityTestHarness.cs" Link="IdentityTestHarness.cs" />
    <Compile Include="..\LiveSmoke\FigureFixtureHarness.cs" Link="FigureFixtureHarness.cs" />
  </ItemGroup>
</Project>
