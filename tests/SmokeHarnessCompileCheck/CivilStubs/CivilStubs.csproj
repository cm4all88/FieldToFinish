<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Civil 3D stand-ins (../../CadCompileCheck/Stubs/Civil.cs) as their own assembly, named as
    Civil 3D's AeccDbMgd, so the smoke harnesses can be compiled as C# 5 against them: the stand-ins
    themselves use newer C#.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AeccDbMgd</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AutoCAD.NET" Version="24.3.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\CadCompileCheck\Stubs\Civil.cs" Link="Civil.cs" />
    <Compile Include="..\..\CadCompileCheck\Stubs\CivilShadows.cs" Link="CivilShadows.cs" />
    <Compile Include="..\..\CadCompileCheck\Stubs\CivilApiNames.g.cs" Link="CivilApiNames.g.cs" Condition="Exists('..\..\CadCompileCheck\Stubs\CivilApiNames.g.cs')" />
  </ItemGroup>
</Project>
