<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reads the public type names of Civil 3D's installed assemblies (AeccDbMgd.dll, AecBaseMgd.dll)
    and writes tests/CadCompileCheck/Stubs/CivilApiNames.g.cs: a placeholder for every Civil 3D
    type the hand-written stand-ins do not declare. The compile checks then know every name
    Civil 3D declares, so a bare name that is ambiguous against AeccDbMgd.dll fails there as it
    fails the Windows build. Run it on a machine with Civil 3D 2024; README.md has the command.

    Reads metadata only (System.Reflection.Metadata): nothing of Autodesk's is loaded or run, and
    no Autodesk file is copied. Not in FieldToFinish.sln; nothing from it ships.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
