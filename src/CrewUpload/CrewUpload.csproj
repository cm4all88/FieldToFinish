<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The crew upload rules: where a dropped file goes in the job folder and what it
         is called. No UI and no CAD types, so all of it is unit tested on any OS.
         netstandard2.0 so the net48 desktop app (and later anything else) can use it. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>CrewUpload.Core</AssemblyName>
    <RootNamespace>CrewUpload</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CrewUpload.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
