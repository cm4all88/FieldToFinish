<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Civil 3D 2024 only, on .NET Framework 4.8. Deliberately single-target while
         the 2024 build is being stabilised: one target, one output path, one thing
         that can be wrong.

         This project previously multi-targeted net48;net8.0-windows with conditional
         reference blocks for a Civil 3D 2026 install. Re-adding it means: restore
         TargetFrameworks, add a $(C3D2026) root with matching Reference items whose
         HintPaths point at it, set UseWindowsForms for the net8.0-windows target
         (WinForms needs the Windows-specific TFM), and add the second ComponentEntry
         to deploy\FieldToFinish.bundle\PackageContents.xml. -->
    <TargetFramework>net48</TargetFramework>

    <!-- Root of the Civil 3D 2024 install. Override when Autodesk is not on C:
             dotnet build -p:C3D2024="D:\...\AutoCAD 2024"
         AeccDbMgd.dll lives in the C3D subfolder; the three AutoCAD assemblies sit in
         the install root. They are NOT in the same directory. -->
    <C3D2024 Condition="'$(C3D2024)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</C3D2024>

    <LangVersion>7.3</LangVersion>
    <AssemblyName>FieldCodes.Cad</AssemblyName>
    <RootNamespace>FieldCodes.Cad</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- AutoCAD loads this into its own process; nothing here runs on its own. -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <Target Name="_FtfCheckCivil3D" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(C3D2024)\AcDbMgd.dll') Or !Exists('$(C3D2024)\C3D\AeccDbMgd.dll')"
           Text="Civil 3D 2024 not found. Looked for AcDbMgd.dll and C3D\AeccDbMgd.dll under '$(C3D2024)'. Set -p:C3D2024=... to the install root." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\FieldCodes\FieldCodes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The grammar ships with the plugin. Without this the DLL loads fine and then
         every command fails at rules lookup. A rules.json beside the drawing still
         wins over this copy. -->
    <None Include="..\..\config\rules.json" Link="rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets net48 build without Visual Studio / the .NET Framework targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Windows OCR and PDF rendering for FTFRECORD (Windows.Media.Ocr, Windows.Data.Pdf):
         the Windows 10 SDK contracts make the in-box WinRT engines callable from .NET
         Framework 4.8. Nothing else is installed on the machine; the OCR languages are the
         ones Windows has. The package is confined to RecordDocumentReader.cs, and a failure to
         load it is reported by FTFRECORD rather than taking the plugin down. Set the Sidecar
         OCR engine in Settings > Recorded Surveys to run without it. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2" />

    <!-- WinForms for the setup window. Framework assemblies, never copied local. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />

    <!-- WPF, for the ribbon: AutoCAD's ribbon API (AdWindows) is WPF, and the
         toolbar icons are drawn in code rather than shipped as image files. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- Civil 3D 2024.
       <Private>false</Private> on every one: copying Autodesk DLLs into the output
       folder is the most common cause of "works on my machine" load failures. -->
  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(C3D2024)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(C3D2024)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(C3D2024)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The ribbon API. -->
    <Reference Include="AdWindows">
      <HintPath>$(C3D2024)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(C3D2024)\C3D\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AEC base layer. Survey figures (FeatureLine, SurveyFigure) inherit through
         AEC entity types defined here, so casting them to AutoCAD entities needs the
         reference. Read-only use: linework identification for the inventory. -->
    <Reference Include="AecBaseMgd">
      <HintPath>$(C3D2024)\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
